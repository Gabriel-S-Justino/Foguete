# Copie para .env (nunca versione o .env). Nenhuma chave paga é necessária para jogar.

# Backend ───────────────────────────────────────────────
# Local (Docker Compose): postgresql://sma:sma_local_dev@localhost:5432/sma
# Neon (produção): use a connection string do painel do Neon, com ?sslmode=require
#   (para muitas instâncias serverless prefira a URL "pooled", com -pooler no host)
DATABASE_URL=postgresql://sma:sma_local_dev@localhost:5432/sma
# Origens permitidas para CORS (separadas por vírgula). Na Vercel, o frontend e a API ficam na mesma origem.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_S=300
SESSION_TTL_DAYS=30
ENVIRONMENT=development

# Frontend (somente valores públicos; tudo com VITE_ vai para o bundle) ─────────────
# Deixe vazio para usar /api na mesma origem (Vercel) ou o proxy do Vite em desenvolvimento.
VITE_API_URL=
# Alvo do proxy do Vite em desenvolvimento (Docker Compose usa http://backend:8000)
VITE_DEV_API_PROXY=http://localhost:8000
